# Copie para .env.local e preencha. NUNCA suba o .env.local para o Git.
# Para rodar `pnpm db:migrate` copie também para `.env` (o drizzle-kit só lê .env).

# --- Meta / Instagram (Passo 4 do README) ---------------------------------
# Use o ID e o segredo do APP DO INSTAGRAM (Casos de uso > API com login do Instagram),
# não os de "Configurações do app > Básico".
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Texto qualquer que você inventa. O mesmo valor vai no campo "Verificar token" do webhook na Meta.
WEBHOOK_VERIFY_TOKEN=

# --- Segredos locais: gere cada um com `openssl rand -hex 32` -------------
# Criptografa o token do Instagram no banco (AES-256). Precisa ter exatamente 64 caracteres hex.
TOKEN_ENC_KEY=
# Assina o cookie de sessão.
SESSION_SECRET=
# Autentica as chamadas dos crons (Authorization: Bearer <valor>).
CRON_SECRET=

# --- Banco (Neon, Postgres) ------------------------------------------------
DATABASE_URL=postgresql://usuario:senha@ep-xxxx-pooler.regiao.aws.neon.tech/neondb?sslmode=require

# --- App -------------------------------------------------------------------
# URL pública, com https e SEM barra no final. Localmente: http://localhost:3000
APP_URL=http://localhost:3000

# --- Opcionais -------------------------------------------------------------
# Domínio "só bio": nesse endereço (ex.: links.seusite.com) a raiz abre a sua página de links
# e nada mais do app (sem login nem painel). Os dois precisam estar preenchidos.
BIO_DOMAIN=
BIO_USERNAME=
# Recebe os alertas de falha (token vencendo, eventos travados, erros reais).
# Aceita a URL de um webhook do Discord ou Slack, ou de um tópico do ntfy.sh.
ALERT_WEBHOOK_URL=
# E-mail exibido nas páginas de Privacidade e Exclusão de dados.
NEXT_PUBLIC_PRIVACY_EMAIL=
# Se definido, o webhook de leads (Leads > Enviar para o meu site) manda
# "Authorization: Bearer <valor>" para o seu endpoint.
LEADS_WEBHOOK_SECRET=
